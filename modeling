def elasticnetcv_feature_select(X, y, num_l1_ratio, alpha_start, alpha_end, num_alpha,
                                max_iter, cv, test_size_ratio, val_split_ratio):
    ####划分训练集,验证集,测试集,特征预处理####
    X_temp, X_test, y_temp, y_test = train_test_split(X, y, 
                                     test_size=test_size_ratio,
                                     random_state=42)
    X_train, X_val, y_train, y_val = train_test_split(X_temp, y_temp, 
                                     test_size=val_split_ratio, 
                                     random_state=42)
    X_train = pd.DataFrame(StandardScaler().fit_transform(X_train),columns=X_train.columns)
    X_test = pd.DataFrame(StandardScaler().fit_transform(X_test),columns=X_test.columns))
    X_val = pd.DataFrame(StandardScaler().fit_transform(X_val), columns=X_val.column)
    alphas = np.logspace(alpha_start, alpha_end, num_l1_ratio)
    # 设定弹性网络模型并进行交叉验证以选择最佳超参数
    if not os.path.exists('elastic_net_feature_select_model.pkl') :
        elastic_net = ElasticNetCV(l1_ratio=np.linspace(0.1, 1, num_l1_ratio),
                     alphas=alphas, cv=cv, max_iter=max_iter, random_state=42)
        elastic_net.fit(X_train, y_train)
        joblib.dump(elastic_net, 'elastic_net_feature_select_model.pkl')
    else :
        elastic_net = joblib.load('elastic_net_feature_select_model.pkl')
    # 获取特征系数
    feature_coef = elastic_net.coef_
    # 获取Best alpha 和 Best l1_ratio
    best_alpha = elastic_net.alpha_
    best_l1_ratio = elastic_net.l1_ratio_ 
    #获取系数部位0的特征
    selected_features = X.columns[feature_coef != 0]
    print('Selected Features by Elastic Net:\n', selected_features.tolist())
    coefs = []
    # 遍历每个alpha值，记录对应的系数
    for a in alphas:
        enet = ElasticNetCV(l1_ratio=best_l1_ratio, alphas=[a], max_iter=max_iter, random_state=42)
        enet.fit(X_train, y_train)
        coefs.append(enet.coef_)
    elasticnetcv_selected_results = {'alphas':alphas, 'coefs':coefs, 'best_alpha':best_alpha, 
                                     'best_l1_ratio':best_l1_ratio, 'feature_coef':feature_coef, 
                                     'selected_features':selected_features}
    return elasticnetcv_selected_results

def permutation_importance_multicollinear(X, fs_thres, n_repeat) :
    # 划分训练集和测试集
    corr = spearmanr(X).correlation
    corr = (corr + corr.T) / 2
    np.fill_diagonal(corr, 1)
    # We convert the correlation matrix to a distance matrix before performing
    # hierarchical clustering using Ward's linkage.
    distance_matrix = 1 - np.abs(corr)
    dist_linkage = hierarchy.ward(squareform(distance_matrix))
    #########feature select#######
    cluster_ids = hierarchy.fcluster(dist_linkage, fs_thres, criterion="distance")
    cluster_id_to_feature_ids = defaultdict(list)
    for idx, cluster_id in enumerate(cluster_ids):
        cluster_id_to_feature_ids[cluster_id].append(idx)
    selected_features = [v[0] for v in cluster_id_to_feature_ids.values()]
    selected_features_names = X.columns[selected_features]
    return selected_features_names.tolist()

